---
# Bootstrap applications configuration
# This file is GENERATED by the pipeline from bootstrap-apps.yaml.j2
# Values are substituted from Azure DevOps Variable Group (rk1-secrets)
# Then encrypted with SOPS before committing to git

bootstrap_apps:
  sprinkler:
    host: {{ SPRINKLER_HOST }}
    port: {{ SPRINKLER_PORT }}

  unifi:
    port: {{ UNIFI_PORT }}
    host: {{ UNIFI_HOST }}

  healthtracking:
    database:
      name: {{ HEALTHTRACKING_DB_NAME }}
      user: {{ HEALTHTRACKING_DB_USER }}
      password: "{{ HEALTHTRACKING_DB_PASSWORD }}"  # Will be encrypted by SOPS

    frontend:
      image: {{ HEALTHTRACKING_FRONTEND_IMAGE }}

    backend:
      image: {{ HEALTHTRACKING_BACKEND_IMAGE }}

  buildagent:
    organization_url: "{{ BUILDAGENT_ORG_URL }}"
    agent_pool: "{{ BUILDAGENT_POOL }}"
    agent_name: "{{ BUILDAGENT_NAME }}"
    pat: "{{ BUILDAGENT_PAT }}"  # Will be encrypted by SOPS

  milo:
    image: "{{ MILO_IMAGE }}"
    log_level: "{{ MILO_LOG_LEVEL }}"
    cors_origins: "{{ MILO_CORS_ORIGINS }}"

    database:
      name: {{ MILO_DB_NAME }}
      user: {{ MILO_DB_USER }}
      password: "{{ MILO_DB_PASSWORD }}"  # Will be encrypted by SOPS

  jetson_agent:
    device_token: "{{ JETSON_AGENT_DEVICE_TOKEN }}"  # Will be encrypted by SOPS
    dashboard_auth_token: "{{ JETSON_DASHBOARD_AUTH_TOKEN }}"  # Will be encrypted by SOPS

  longhorn:
    ingress:
      host: "{{ LONGHORN_INGRESS_HOST }}"

  mqtt:
    loadbalancer_ip: "{{ MQTT_LOADBALANCER_IP }}"
  vestaboard:
    image: "{{ VESTABOARD_IMAGE }}"

  avserver:
    image: "immersiveroom.azurecr.io/immersive-room/avserver-mock:latest"
