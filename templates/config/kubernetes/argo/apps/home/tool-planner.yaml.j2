---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: tool-planner
  namespace: argo-system
  annotations:
    argocd.argoproj.io/sync-wave: '2'
spec:
  project: kubernetes
  sources:
    - repoURL: "https://github.com/#{ repository_name }#.git"
      path: kubernetes/apps/home/tool-planner
      targetRevision: #{ repository_branch }#
      ref: repo
    - repoURL: https://github.com/enicky/toolplanner.git
      path: deploy/helm/tool-planner
      targetRevision: "#{ bootstrap_apps.tool_planner.chart_version }#"
      helm:
        releaseName: tool-planner
        valueFiles:
          - $repo/kubernetes/apps/home/tool-planner/values.yaml
  destination:
    name: in-cluster
    namespace: home
  syncPolicy:
    automated:
      allowEmpty: true
      prune: true
      selfHeal: true
    retry:
      limit: 1
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
    syncOptions:
      - CreateNamespace=true
