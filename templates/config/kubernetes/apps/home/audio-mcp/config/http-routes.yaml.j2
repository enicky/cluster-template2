---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: audio-mcp
  namespace: home
spec:
  parentRefs:
    - name: envoy-external
      namespace: network
      sectionName: https
  hostnames:
    - audio-mcp.#{ cloudflare_domain }#
  rules:
    - backendRefs:
        - name: audio-mcp
          port: 8001
