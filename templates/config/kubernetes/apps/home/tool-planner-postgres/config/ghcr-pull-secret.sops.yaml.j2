---
apiVersion: v1
kind: Secret
metadata:
  name: tool-planner-ghcr
  namespace: home
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: >-
    {"auths":{"ghcr.io":{"username":"#{ bootstrap_apps.tool_planner.ghcr.username }#","password":"#{ bootstrap_apps.tool_planner.ghcr.read_token }#","auth":"#{ (bootstrap_apps.tool_planner.ghcr.username ~ ':' ~ bootstrap_apps.tool_planner.ghcr.read_token) | base64_encode }#"}}}
