---
apiVersion: v1
kind: Secret
metadata:
  name: tool-planner-secrets
  namespace: home
type: Opaque
stringData:
  database-url: "postgresql+psycopg://toolplanner:#{ bootstrap_apps.tool_planner.postgres.password }#@tool-planner-postgres.home.svc.cluster.local:5432/toolplanner"
  POSTGRES_DB: toolplanner
  POSTGRES_USER: toolplanner
  POSTGRES_PASSWORD: "#{ bootstrap_apps.tool_planner.postgres.password }#"
