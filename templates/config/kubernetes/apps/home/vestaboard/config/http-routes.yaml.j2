---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: vestaboard
  namespace: home
spec:
  parentRefs:
    - name: envoy-external
      namespace: network
      sectionName: https
  hostnames:
    - vestaboard.#{ cloudflare_domain }#
  rules:
    - backendRefs:
        - name: vestaboard
          port: 5000
