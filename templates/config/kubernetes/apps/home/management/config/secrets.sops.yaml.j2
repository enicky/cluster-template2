apiVersion: v1
kind: Secret
metadata:
  name: management-secrets
  namespace: home
type: Opaque
stringData:
  MCP_TOKEN: #{ bootstrap_apps.management.database.mcp_token }#
  MANAGEMENT_API_TOKEN: #{ bootstrap_apps.management.database.management_api_token }#
  AZURE_STORAGE_CONNECTION_STRING: #{ bootstrap_apps.management.database.azure_storage_connection_string }#
