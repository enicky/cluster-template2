apiVersion: v1
kind: Secret
metadata:
  name: management-secrets
  namespace: home
type: Opaque
stringData:
  MCP_TOKEN: #{ bootstrap_apps.management.MCP_TOKEN }#
  MANAGEMENT_API_TOKEN: #{ bootstrap_apps.management.MANAGEMENT_API_TOKEN }#
#% if bootstrap_apps.management.TAB5_IMR_TOKEN_SHA256 | default('', true) %#
  TAB5_IMR_TOKEN_SHA256: #{ bootstrap_apps.management.TAB5_IMR_TOKEN_SHA256 | tojson }#
#% endif %#
  AZURE_STORAGE_CONNECTION_STRING: #{ bootstrap_apps.management.AZURE_STORAGE_CONNECTION_STRING }#
