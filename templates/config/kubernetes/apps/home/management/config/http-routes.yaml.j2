---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: management
  namespace: home
spec:
  parentRefs:
    - name: envoy-external
      namespace: network
      sectionName: https
  hostnames:
    - management.#{ cloudflare_domain }#
  rules:
    - backendRefs:
        - name: management
          port: 8004
