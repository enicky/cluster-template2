---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: image-services-mcp
  namespace: home
spec:
  parentRefs:
    - name: envoy-external
      namespace: network
      sectionName: https
  hostnames:
    - image-services-mcp.#{ cloudflare_domain }#
  rules:
    - backendRefs:
        - name: image-services-mcp
          port: 8007
