---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: av-mcp
  namespace: home
spec:
  parentRefs:
    - name: envoy-external
      namespace: network
      sectionName: https
  hostnames:
    - av-mcp.#{ cloudflare_domain }#
  rules:
    - backendRefs:
        - name: av-mcp
          port: 8000
