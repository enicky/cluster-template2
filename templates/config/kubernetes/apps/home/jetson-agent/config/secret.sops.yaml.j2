---
apiVersion: v1
kind: Secret
metadata:
  name: jetson-agent
  namespace: home
type: Opaque
stringData:
  DEVICE_TOKEN: #{ bootstrap_apps.jetson_agent.device_token }#
  DASHBOARD_AUTH_TOKEN: #{ bootstrap_apps.jetson_agent.dashboard_auth_token }#
  STRIIDE_VOICE_URL: #{ bootstrap_apps.jetson_agent.striide_voice_url }#
  STRIIDE_VOICE_WORKFLOW_UUID: #{ bootstrap_apps.jetson_agent.striide_voice_workflow_uuid }#
  STRIIDE_VOICE_AUTH_TOKEN: #{ bootstrap_apps.jetson_agent.striide_voice_auth_token }#
